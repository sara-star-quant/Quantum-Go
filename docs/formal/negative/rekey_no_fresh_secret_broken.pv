(*
  PLANTED FLAW: the rekey is a hash ratchet. new_master = KDF(old_master, constant) mixes no
  fresh KEM secret, so whoever holds the epoch-1 master computes epoch 2. Must FAIL the
  epoch-2 secrecy query. Twin of chkem_rekey.pv.
*)
const noFresh: bitstring.

free secretE0: bitstring [private].
free secretE2: bitstring [private].
free c1, c2: channel [private].

query attacker(secretE2).

let rekeyStep(masterIn: bitstring, out_ch: channel) =
  new fsk: skey;
  let kReq = kdfDir(masterIn, dirI2R) in
  let kResp = kdfDir(masterIn, dirR2I) in
  (* initiator: fresh KEM public key, sealed under the current epoch key *)
  let rekeyInit = senc(pkb(fsk), kReq) in
  out(net, rekeyInit);
  (* responder: opens it, encapsulates a fresh secret, seals the ciphertext *)
  let pkNew = sdec(rekeyInit, kReq) in
  new ss: bitstring;
  let rekeyResp = senc(kemenc(pkNew, ss), kResp) in
  out(net, rekeyResp);
  (* initiator: opens the response and decapsulates *)
  let ct = sdec(rekeyResp, kResp) in
  let ssI = kemdec(ct, fsk) in
  out(out_ch, rekeyKdf(masterIn, noFresh)).   (* the flaw: the fresh secret is ignored *)

process
  new master0: bitstring;
  ( out(net, senc(secretE0, kdfTraffic(master0)))
  | rekeyStep(master0, c1)
  | ( in(c1, master1: bitstring);
      out(net, master1);
      out(net, kdfTraffic(master1));
      rekeyStep(master1, c2) )
  | ( in(c2, master2: bitstring);
      out(net, senc(secretE2, kdfTraffic(master2))) ) )
